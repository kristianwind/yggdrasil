[Unit]
Description=Yggdrasil Game Server Management Panel
Documentation=https://github.com/yggdrasil-panel/yggdrasil
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=yggdrasil
Group=yggdrasil
# The service user must be in the 'docker' group (handled by install.sh).
ExecStart=/usr/local/bin/yggdrasil --config /etc/yggdrasil/config.yaml
Restart=on-failure
RestartSec=5
# State / data
StateDirectory=yggdrasil
WorkingDirectory=/var/lib/yggdrasil

# Backups run as the yggdrasil user and stream each server's data dir. Some apps
# write files mode 0600 owned by their container PUID (.NET DataProtection keys,
# MariaDB healthcheck creds, qBittorrent logs) that this user otherwise can't
# read — the whole backup then fails on the first such file. This capability lets
# the reader bypass file-permission checks (read-only) without granting full root.
AmbientCapabilities=CAP_DAC_READ_SEARCH

# Hardening (kept compatible with Docker socket access)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/yggdrasil /etc/yggdrasil

[Install]
WantedBy=multi-user.target
